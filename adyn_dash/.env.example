# Copy to a local .env; do not put real values in version control.
ADYN_POSTGRES_HOST=replace-me
ADYN_POSTGRES_PORT=5432
ADYN_POSTGRES_DB=replace-me
ADYN_POSTGRES_USER=replace-me
ADYN_POSTGRES_PASSWORD=replace-me
# Optional: leave unset to use the database role's default search path.
